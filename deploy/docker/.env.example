# Copy to .env next to docker-compose.yml and adjust.

# Postgres
POSTGRES_DB=deepscan
POSTGRES_USER=deepscan
POSTGRES_PASSWORD=change-me

# Admin UI host port
ADMIN_PORT=8900

# Number of worker replicas (horizontal scaling)
KRUNCHER_REPLICAS=2

# Nexus pull-through mirror (dependency resolver -> package registries).
# NEXUS_PORT exposes the admin UI on the host. NEXUS_ADMIN_PASSWORD is the admin
# password the provisioner logs in with; the first-boot default is admin123 when
# NEXUS_SECURITY_RANDOMPASSWORD=false (set in compose). CHANGE IT before exposing.
NEXUS_PORT=8081
NEXUS_ADMIN_PASSWORD=admin123

# Connector tokens. Each scope references one of these by name via its
# `token_env` (e.g. {"url":"...","token_env":"GITHUB_TOKEN"}). The whole .env is
# injected into the app containers, so ANY variable name works here - add your
# own (e.g. MY_PAT=...) and reference it from the scope.
#
# Leave a token blank / omit it entirely to scan PUBLIC repos anonymously, e.g.
# a scope with just {"url":"https://github.com/michoo/flanby"} needs no token.
GITHUB_TOKEN=
GITLAB_TOKEN=

# --- Scanner toggles ------------------------------------------------------
# Any scanner can be turned off (or an off-by-default one turned on) with an env
# var named after it: UPPERCASE, dashes -> underscores. A value of
# false/0/no/off/disable(d) disables it. This file is injected into the whole
# worker fleet, so a toggle here applies to every scan.
#
#   codeql -> CODEQL   trivy-misconfig -> TRIVY_MISCONFIG
#   nuclei -> NUCLEI   cisco-ai-skill-scanner -> CISCO_AI_SKILL_SCANNER
#
# Disable a scanner (uncomment as needed):
# NUCLEI=false            # DAST templates
# CLAMAV=false            # malware signatures
#
# Opt IN an off-by-default scanner:
# CODEQL=true             # deep CodeQL SAST - slow & RAM-heavy, OFF by default
# AI_ANALYSIS=true        # LLM triage (needs a model - see docs/scanners.md)

# --- Anonymous telemetry (optional) ---------------------------------------
# Set a Sentry DSN to push anonymous scan metrics (counts by family/severity,
# durations, usage by surface) from the API + kruncher fleet. Off when unset;
# force-off with DEEPSCAN_TELEMETRY=false. Lower the sample rate for big fleets.
SENTRY_DSN=
# DEEPSCAN_TELEMETRY=false
# SENTRY_ENVIRONMENT=production
# SENTRY_TRACES_SAMPLE_RATE=1.0
