# Secret material for the kustomize secretGenerator -> Secret/deepscan-secrets.
# KEY=VALUE per line. REPLACE the placeholders before applying; do NOT commit
# real secrets (use a SealedSecret / ExternalSecret, or keep this file out of git).
#
# You can seed the token lines straight from your docker compose .env
# (deploy/docker/.env) - they share the GITHUB_TOKEN / GITLAB_TOKEN names. Add a
# line per custom `token_env` your scopes reference (e.g. MY_PAT=...).
#
# Public-repo scopes (e.g. {"url":"https://github.com/michoo/flanby"}) need no token.

DEEPSCAN_DB_PASSWORD=change-me
POSTGRES_PASSWORD=change-me
GITHUB_TOKEN=
GITLAB_TOKEN=
